# ============================================================
# KasFlow — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ── Supabase (REQUIRED) ─────────────────────────────────────
# Project URL from Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable key from Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Secret key — used by server-side API routes only (NEVER expose to client)
# Found in Supabase Dashboard → Project Settings → API Keys
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── App URL (required for OAuth callbacks) ───────────────────
# Base URL of your deployed app (no trailing slash)
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Centralized Auth Broker (OPTIONAL) ──────────────────────
# Leave empty to use your own domain directly for Shopee/TikTok callbacks.
# Only set this if you route callbacks through a centralized broker (e.g. https://auth.bakwan.my.id)
AUTH_BROKER_URL=

# ── Auth Configuration ──────────────────────────────────────
# Set 'true' to enable Google OAuth Login button, 'false' to disable
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
# Email address for Super Admin access (/admin)
NEXT_PUBLIC_SUPERADMIN_EMAIL=

# ── TikTok Shop Integration (OPTIONAL) ──────────────────────
# Only needed if you use the marketplace/TikTok Shop integration.
# Get these from TikTok Shop Partner Center → App Management
TIKTOK_APP_KEY=your_tiktok_app_key
TIKTOK_APP_SECRET=your_tiktok_app_secret

# ── Shopee Open Platform Integration (OPTIONAL) ─────────────
# Only needed if you use the marketplace/Shopee integration.
# Get these from Shopee Open Platform Console → App Detail
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key
